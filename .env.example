# Copy this file to `.env` and fill every value (see “Where to get” below).
# Never commit `.env` — it is listed in `.gitignore`.
#
# upload_cloudflare.py only needs Cloudflare account + D1 (Bearer token). Variant product images are
# stored as manufacturer URLs in CSV/D1, not uploaded from disk.
#
# R2 API keys below are still used by the Worker for technical PDF / catalog uploads (not variant photos).

# -----------------------------------------------------------------------------
# CLOUDFLARE_ACCOUNT_ID
# Where: Cloudflare Dashboard → any page’s right sidebar often shows “Account ID”,
#        or Workers & Pages → Overview → Account details → Account ID.
# Format: 32 hex characters (no dashes).
# Must match `account_id` in `wrangler.toml`.
# -----------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=

# -----------------------------------------------------------------------------
# CLOUDFLARE_API_TOKEN
# Where: Dashboard → Manage Account (profile menu) → API Tokens → Create Token.
#        Use “Create Custom Token”, add permissions at minimum:
#          Account → Workers Scripts → Edit (if you use Workers), and
#          Account → Workers R2 Storage → Edit (if you use Worker PDF/catalog uploads), and
#          Account → D1 → Edit
#        Or start from “Edit Cloudflare Workers” template and add D1 + R2 if missing.
# Format: long single string starting with letters (secret — treat like a password).
# -----------------------------------------------------------------------------
CLOUDFLARE_API_TOKEN=

# -----------------------------------------------------------------------------
# CLOUDFLARE_D1_DATABASE_ID
# Where: Workers & Pages → D1 → click your database → copy “Database ID” (UUID).
# Must match `database_id` under [[d1_databases]] in `wrangler.toml`.
# -----------------------------------------------------------------------------
CLOUDFLARE_D1_DATABASE_ID=

# -----------------------------------------------------------------------------
# R2_BUCKET_NAME
# Where: R2 → Object Storage → bucket list → exact bucket name (case-sensitive).
# Must match `bucket_name` under [[r2_buckets]] in `wrangler.toml`.
# -----------------------------------------------------------------------------
R2_BUCKET_NAME=

# -----------------------------------------------------------------------------
# R2_ACCESS_KEY_ID  and  R2_SECRET_ACCESS_KEY  (S3 API — not the same value as CLOUDFLARE_API_TOKEN)
# Where: R2 → Overview → “Manage R2 API Tokens” → Create API token.
#        Cloudflare shows an Access Key ID and Secret Access Key (pair). Copy both once;
#        the secret is shown only at creation time.
# Permissions: Object Read & Write on this bucket (or Admin Read & Write if tools complain).
# Used by the Worker for R2 object uploads (PDFs/catalogs), not by upload_cloudflare.py.
# -----------------------------------------------------------------------------
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# -----------------------------------------------------------------------------
# R2_PUBLIC_BASE_URL (optional)
# Where: After enabling public access on the bucket or binding a custom domain / r2.dev URL,
#        use that base URL so links look like: {R2_PUBLIC_BASE_URL}/{key}
# Example: https://pub-xxxxxxxxxxxxxxxx.r2.dev
# -----------------------------------------------------------------------------
# R2_PUBLIC_BASE_URL=
